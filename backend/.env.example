# Server Configuration
PORT=3001
NODE_ENV=production

# Database
MONGODB_URI=mongodb://localhost:27017/raffle_db
# MongoDB connection options
MONGODB_POOL_SIZE=10
MONGODB_TIMEOUT=30000

# JWT Configuration
JWT_SECRET=your_very_long_secret_key_minimum_32_characters_change_in_production_NOW
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_minimum_32_characters_change_in_production_NOW
JWT_REFRESH_EXPIRE=30d

# Encryption Configuration (REQUIRED - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=generate_a_random_hex_string_minimum_64_characters_for_aes256_encryption

# Frontend URL (with protocol)
FRONTEND_URL=https://example.com

# CORS Configuration
CORS_ORIGIN=https://example.com
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MESSAGE=Muitas requisições deste IP, tente novamente em 15 minutos

# Security
ALLOWED_ORIGINS=https://example.com,https://www.example.com
SECURE_COOKIES=true
HTTP_ONLY_COOKIES=true
SAME_SITE_COOKIES=Strict

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=noreply@example.com

# Payment Configuration
PAYMENT_TIMEOUT=30000
MAX_PAYMENT_AMOUNT=999999.99
MIN_PAYMENT_AMOUNT=0.01

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# Session Configuration
SESSION_SECRET=your_session_secret_minimum_32_characters_change_in_production
SESSION_TIMEOUT=3600000

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp
UPLOAD_DIR=./uploads

# API Configuration
API_VERSION=v1
API_PREFIX=/api/v1
DEVELOPMENT=false
